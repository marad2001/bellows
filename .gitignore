/target

# Operator-local config (the example lives at orchestrator.example.toml).
orchestrator.toml

# Default log file location.
bellows.log

# Claude Code local state (permissions, etc.) — per-operator, never
# committed.
.claude/

# Operator-local runtime state, written by the polling loop alongside
# bellows.log. Both are per-install and per-run; neither is source.
bellows-state.json
runs.jsonl
